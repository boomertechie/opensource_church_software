# Church Starter Stack Configuration
# Copy this file to .env and fill in your values BEFORE running docker compose up.
#
# This stack uses fail-fast secrets: any variable marked :? will cause the stack
# to refuse to start with a clear error message until you set a real value.
# There are no working defaults — that is intentional.
#
# Generate strong passwords with:  openssl rand -base64 24

# ===================
# YOUR DOMAIN NAMES
# ===================
# These must point to your server's IP address in DNS
WORDPRESS_DOMAIN=www.yourchurch.com
CHURCHCRM_DOMAIN=members.yourchurch.com
LISTMONK_DOMAIN=news.yourchurch.com
VAULTWARDEN_DOMAIN=vault.yourchurch.com

# ===================
# YOUR EMAIL
# ===================
# Used for SSL certificate notifications from Let's Encrypt
ACME_EMAIL=pastor@yourchurch.com

# ===================
# PASSWORDS — REQUIRED, NO DEFAULTS
# ===================
# Generate each one with:  openssl rand -base64 24
# Then paste the output here. Do not share this file or commit it to git.

# WordPress database password
WORDPRESS_DB_PASSWORD=

# ChurchCRM database password
CHURCHCRM_DB_PASSWORD=

# Listmonk admin login
LISTMONK_USER=admin
LISTMONK_PASSWORD=

# Listmonk database password
LISTMONK_DB_PASSWORD=

# Vaultwarden admin token (for creating accounts)
# Generate with:  openssl rand -base64 48
VAULTWARDEN_ADMIN_TOKEN=
