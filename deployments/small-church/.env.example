# Small Church Stack Environment Variables
#
# Copy this file to .env and fill in every value BEFORE running docker compose up.
#
# This stack uses fail-fast secrets: any variable left blank will cause the stack
# to refuse to start with a clear error message. There are no working defaults —
# that is intentional.
#
# Generate strong passwords with:  openssl rand -base64 24

# Domain Configuration
# Point these subdomains to your server IP in DNS
WORDPRESS_DOMAIN=www.yourchurch.com
CHURCHCRM_DOMAIN=crm.yourchurch.com
NEXTCLOUD_DOMAIN=files.yourchurch.com
LISTMONK_DOMAIN=news.yourchurch.com
UPTIME_DOMAIN=status.yourchurch.com

# Let's Encrypt Configuration
ACME_EMAIL=admin@yourchurch.com

# Timezone
TZ=America/New_York

# Database Passwords — REQUIRED, NO DEFAULTS
# Generate each with:  openssl rand -base64 24
WORDPRESS_DB_PASSWORD=
CHURCHCRM_DB_PASSWORD=
NEXTCLOUD_DB_PASSWORD=
MYSQL_ROOT_PASSWORD=
MYSQL_ROOT_PASSWORD_2=
MYSQL_ROOT_PASSWORD_3=

# Nextcloud Admin — REQUIRED
NEXTCLOUD_ADMIN_USER=admin
NEXTCLOUD_ADMIN_PASSWORD=

# Listmonk Admin — REQUIRED
LISTMONK_ADMIN_USER=admin
LISTMONK_ADMIN_PASSWORD=
LISTMONK_DB_PASSWORD=

# Diun (image-update notifications)
# Diun does NOT auto-update containers — it emails you when an image has a new tag.
# To apply an update: docker compose pull && docker compose up -d
DIUN_EMAIL_FROM=admin@yourchurch.com
DIUN_EMAIL_TO=admin@yourchurch.com
DIUN_EMAIL_SERVER=smtp.gmail.com
DIUN_EMAIL_PORT=587
DIUN_EMAIL_USER=
DIUN_EMAIL_PASSWORD=
